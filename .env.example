# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas (Replica Set required for multi-document transactions)
MONGODB_URI=mongodb://localhost:27017/pharmaerp?replicaSet=rs0
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pharmaerp?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_super_secure_key_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Initial Default Owner Account (Auto-seeded if no user exists)
DEFAULT_OWNER_USERNAME=admin
DEFAULT_OWNER_PASSWORD=admin123
DEFAULT_OWNER_NAME="Pharmacy Owner"
